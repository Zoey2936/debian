#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

export GOFLAGS := -buildmode=pie -modcacherw -trimpath -buildvcs=false
export GOCACHE := $(CURDIR)/_build/cache
export GOMODCACHE := $(CURDIR)/_build/mod

%:
	dh $@

override_dh_auto_clean:
	rm -rf _build bin build/static

override_dh_auto_build:
	cp -r frontend/static build/
	go build -o bin/adguardhome -ldflags "-s -w \
		-X github.com/AdguardTeam/AdGuardHome/internal/version.version=v$(DEB_VERSION_UPSTREAM) \
		-X github.com/AdguardTeam/AdGuardHome/internal/version.channel=release \
		-X github.com/AdguardTeam/AdGuardHome/internal/version.committime=$(SOURCE_DATE_EPOCH)"

override_dh_auto_test:
#	go test ./...

override_dh_auto_install:
	install -Dm755 bin/adguardhome -t debian/adguardhome/usr/bin/
